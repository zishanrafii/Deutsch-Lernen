rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ──
    // প্রতিটা user শুধু নিজের document পড়তে/লিখতে পারবে।
    // অন্য কারো uid-এর document touch করতে পারবে না।
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // প্রথমবার profile তৈরি (registration-এর সময়)
      // role, plan, banned — কোনোটাই নিজে সেট করতে পারবে না (সবসময় "user" / free / false থেকে শুরু)
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == "user")
        && (!('plan' in request.resource.data) || request.resource.data.plan == "free")
        && (!('planProvider' in request.resource.data) || request.resource.data.planProvider == null)
        && (!('planExpiry' in request.resource.data) || request.resource.data.planExpiry == null)
        && (!('banned' in request.resource.data) || request.resource.data.banned == false);

      // Update — XP কমানো/masteredVocabIds মোছা (cheat) আটকানো
      // + role, plan, banned, planExpiry ইত্যাদি sensitive field client থেকে change করা আটকানো
      //   (শুধু admin SDK — payment webhook / admin panel — এগুলো লিখতে পারবে, কারণ Admin SDK rules bypass করে)
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
             ['role','plan','planProvider','planStart','planExpiry','banned',
              'stripeCustomerId','stripeSessionId',
              // ── referral fields — only the applyReferral Cloud Function
              // (Admin SDK, bypasses these rules) may change these ──
              'referredBy','referrals','referralCount','freeDaysEarned','referralActivity']
           )
        && (
          !('xp' in request.resource.data) ||
          !('xp' in resource.data) ||
          (request.resource.data.xp >= resource.data.xp &&
           request.resource.data.xp - resource.data.xp <= 300)
        )
        && (
          !('masteredVocabIds' in request.resource.data) ||
          !('masteredVocabIds' in resource.data) ||
          request.resource.data.masteredVocabIds.size() >= resource.data.masteredVocabIds.size()
        );

      allow delete: if false;

      // ── users/{uid}/dictionaryStats/{level} (যদি ব্যবহার করেন) ──
      match /dictionaryStats/{level} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── scores ──
    // user নিজের score লিখতে পারবে, কিন্তু uid স্পুফ করতে পারবে না।
    match /scores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── grammar_lessons, vocab_words ──
    // সবার জন্য read-only reference data। লেখা শুধু admin panel থেকে (নিচে দেখুন)।
    match /grammar_lessons/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // admin SDK / console থেকেই হবে
    }
    match /vocab_words/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── community_posts ──
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── reading_passages ──
    // সব logged-in user পড়তে পারবে (lesen.html-এর জন্য দরকার); লেখা শুধু admin/import-tool থেকে
    match /reading_passages/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── payment_requests ──
    // user নিজের payment request তৈরি করতে পারবে, uid স্পুফ করতে পারবে না।
    // ⚠️ read এখনো সব logged-in user-এর জন্য খোলা রাখতে হচ্ছে, কারণ bkash-payment.html-এর
    // duplicate-transactionId check এখনো client-side (পুরো collection-এ query করে) —
    // server-side (Cloud/Netlify Function) migrate করলে এটা uid-scoped করে ফেলা যাবে।
    // approve/reject শুধু admin panel (Admin SDK) থেকে হবে।
    match /payment_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── writings (AI writing feedback submissions) ──
    // শুধু নিজের submission পড়তে/তৈরি করতে পারবে
    match /writings/{writingId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── publicProfiles/{uid} ──
    // নাম, ছবি, XP-এর মতো non-sensitive fields-এর একটা PUBLIC mirror।
    // freunde.html (browse/add friend) ও rangliste.html (leaderboard)
    // এটা ব্যবহার করে — কখনো users/{uid}-এর মতো sensitive collection
    // সরাসরি অন্য user পড়ে না। firebase-config.js-এর requireAuth()
    // প্রতিটা page load-এ নিজের publicProfile auto-sync করে।
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','photoURL','xp','createdAt']);
      allow delete: if false;
    }

    // ── friendRequests/{reqId} ──
    // শুধু sender/recipient নিজেদের request পড়তে/লিখতে পারবে।
    match /friendRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      allow create: if request.auth != null &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.to != request.auth.uid &&
        request.resource.data.status == "pending";

      // শুধু recipient accept করতে পারবে (status → accepted), অন্য কিছু বদলাতে পারবে না
      allow update: if request.auth != null &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == "accepted";

      // cancel (sender) বা unfriend (উভয়ে) — দুজনেই delete করতে পারবে
      allow delete: if request.auth != null &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ── conversations/{convId} — Community Chat (Messenger-style) ──
    // শুধু participants রা নিজেদের conversation পড়তে/লিখতে পারবে।
    match /conversations/{convId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2;

      // Chat metadata update (lastMessage, unreadCount, group info) — শুধু participants
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // ── messages subcollection ──
      match /messages/{msgId} {
        function isParticipant() {
          return request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
          && request.resource.data.senderId == request.auth.uid;

        // Update শুধু নির্দিষ্ট purpose-এ: seen mark করা, react করা, বা নিজের message soft-delete করা
        allow update: if isParticipant() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','text'])
            && resource.data.senderId == request.auth.uid)
        );

        allow delete: if false;
      }

      // ── typing/{uid} — টাইপ করছে কিনা flag, শুধু নিজেরটা লিখতে পারবে ──
      match /typing/{uid} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── presence/{uid} — online/last-seen heartbeat, সবাই পড়তে পারবে ──
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Admin override (role: "admin" থাকলে সবকিছু করতে পারবে) ──
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}