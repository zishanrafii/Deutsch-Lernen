{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "netlify/**",
      "netlify.toml",
      "seed-data/**"
    ],
    "rewrites": [
      { "source": "/createCheckout",  "function": "createCheckout" },
      { "source": "/stripeWebhook",   "function": "stripeWebhook" },
      { "source": "/sslcommerzInit",  "function": "sslcommerzInit" },
      { "source": "/sslcommerzIpn",   "function": "sslcommerzIpn" },
      { "source": "/writingFeedback", "function": "writingFeedback" },
      { "source": "/checkDuplicateTxn", "function": "checkDuplicateTxn" }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
